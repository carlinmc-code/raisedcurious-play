/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Cache-Control: public, max-age=300
# No Cache-Control rule for /assets/*: Cloudflare Pages honours Cache-Control
# from this file for HTML only. Every JS and CSS response is served with the
# platform default (public, max-age=14400) no matter what is written here --
# verified against /assets/toy.js, /marblerun/game.js and /shared/kit.js.
# Shared scripts must therefore be versioned in the URL, not cached shorter.
